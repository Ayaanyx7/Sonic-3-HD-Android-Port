<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Target modern Android via .NET 8 -->
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    
    <!-- CRITICAL CONFIGURATION: Points directly to your manifest layout block -->
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <UseRidGraph>true</UseRidGraph>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    
    <!-- Must be Exe for MonoGame runtime entry points -->
    <OutputType>Exe</OutputType>
    
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>5.0</LangVersion> 
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    
    <AssemblyName>Sonic3HD</AssemblyName>
    <RootNamespace>Sonic3HD</RootNamespace>
    
    <ApplicationId>com.sonic3hd.androidport</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- EXPLICIT APP LINKS: Ensures MainActivity is recognized cleanly outside wildcards -->
    <Compile Include="MainActivity.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../src/**/*.cs" />
    
    <!-- Clear decompiler assembly tokens -->
    <Compile Remove="$(MSBuildThisFileDirectory)../src/**/&lt;Module&gt;*.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)../src/**/&lt;PrivateImplementationDetails&gt;*.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)../src/**/Delegate*.cs" />

    <!-- Modern MonoGame Engine Backend for Android -->
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.2.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Map the assets explicitly from the target directory tree -->
    <AndroidAsset Include="$(MSBuildThisFileDirectory)../src/Content/**/*" />
  </ItemGroup>
</Project>
