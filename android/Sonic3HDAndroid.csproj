<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Target modern Android via .NET 8 -->
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    
    <!-- CRITICAL FIX: Locks target to mobile arm64 and forces the compiler to accept legacy profiles safely -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <UseRidGraph>true</UseRidGraph>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    
    <!-- CRITICAL: Must be Library for Android, NOT Exe -->
    <OutputType>Library</OutputType>
    
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    
    <!-- Matches your C# 5.0 dnSpy extraction baseline perfectly -->
    <LangVersion>5.0</LangVersion> 
    
    <!-- Prevents duplicate assembly metadata property conflicts -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    
    <AssemblyName>Sonic3HD</AssemblyName>
    <RootNamespace>Sonic3HD</RootNamespace>
    
    <ApplicationId>com.sonic3hd.androidport</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
  </PropertyGroup>
